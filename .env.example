# ==============================================================================
# Intelligent Project Knowledge Reconstruction & Handover Platform
# Environment Variable Template
#
# SECURITY & CONFIGURATION RULES:
# - Copy this file to `.env` for local development. NEVER commit `.env`.
# - Keep all secrets, API tokens, and encryption keys strictly on the backend.
# - NEVER expose secrets via NEXT_PUBLIC_* variables or browser JavaScript.
# - Variables are grouped into:
#     1. MANDATORY (Local Startup) — required to boot core services.
#     2. OPTIONAL INTEGRATIONS — disabled by default (`*_ENABLED=false`);
#        developers do NOT need to populate credentials while disabled.
#     3. DEPLOYMENT-SPECIFIC & TUNING — safe defaults; override per environment.
# ==============================================================================

# ==============================================================================
# 1. MANDATORY VARIABLES (Core Local Development Startup)
# ==============================================================================

# --- Backend Runtime ---
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend Public Configuration (PUBLIC ONLY — NO SECRETS) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- PostgreSQL (Canonical Store via SQLAlchemy 2.x + Psycopg 3) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_handover
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-postgres-password
DATABASE_URL=postgresql+psycopg://postgres:change-me-local-postgres-password@localhost:5432/knowledge_handover

# --- ChromaDB (Dedicated HTTP Server Mode via Docker Compose) ---
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_PREFIX=ipkrh

# --- Local Ollama (LLM, Embeddings & Initial GLM OCR Runtime) ---
OLLAMA_BASE_URL=http://localhost:11434
# Initial model to benchmark
OLLAMA_LLM_MODEL=qwen3:8b
# Must remain identical between ingestion indexing and RAG query retrieval
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Initial OCR model hosted in local Ollama behind backend OCR abstraction
OLLAMA_OCR_MODEL=glm-ocr:latest

# --- FastAPI-Managed Platform Authentication & Encryption Keys ---
JWT_SECRET_KEY=change-me-generate-minimum-32-byte-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Backend symmetric key for encrypting stored external source OAuth tokens in PostgreSQL
TOKEN_ENCRYPTION_KEY=change-me-generate-32-byte-fernet-or-aes-key
# Backend symmetric key for encrypting uploaded files at rest in local private storage
FILE_ENCRYPTION_KEY=change-me-generate-32-byte-file-encryption-key

# --- Private Document Upload Storage (Outside Frontend Public Directories) ---
UPLOAD_STORAGE_PATH=./data/uploads

# ==============================================================================
# 2. OPTIONAL SOURCE INTEGRATIONS (Disabled by Default)
# Developers do NOT need to populate credentials for disabled integrations.
# ==============================================================================

# --- GitHub API Connector (Initial Priority When Connecting External Sources) ---
GITHUB_ENABLED=false
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback

# --- Jira API Connector (Initial Priority When Connecting External Sources) ---
JIRA_ENABLED=false
JIRA_AUTH_BASE_URL=https://auth.atlassian.com
JIRA_API_BASE_URL=https://api.atlassian.com
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:8000/api/v1/integrations/jira/callback

# --- Slack API Connector (Optional MVP — Gated by Workspace Auth, Scopes & Retention) ---
SLACK_ENABLED=false
SLACK_API_BASE_URL=https://slack.com/api
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/api/v1/integrations/slack/callback

# ==============================================================================
# 3. DEPLOYMENT-SPECIFIC & TUNING VARIABLES (Safe Defaults Provided)
# ==============================================================================

APP_NAME="Intelligent Project Knowledge Reconstruction & Handover Platform"

# JWT Issuer / Audience Validation (Optional; leave empty to omit iss/aud claims)
JWT_ISSUER=ipkrh-platform
JWT_AUDIENCE=ipkrh-api

# Authentication Rate Limiting (In-process default; replace at gateway/shared store in prod)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Cookie Security (MUST set COOKIE_SECURE=true in HTTPS staging/production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Upload Constraints
MAX_UPLOAD_SIZE_MB=50

# Lightweight Python Background Worker Tuning (PostgreSQL-Backed Job Queue)
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_MAX_ATTEMPTS=3

# Environment-Specific Persistence Hardening (Production / Staging Overrides)
POSTGRES_SSL_MODE=prefer
CHROMA_AUTH_TOKEN=

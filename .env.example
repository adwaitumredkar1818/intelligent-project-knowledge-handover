# ==============================================================================
# Intelligent Project Knowledge Reconstruction & Handover Platform
# Environment Variable Template
#
# SECURITY & CONFIGURATION RULES:
# - Copy this file to `.env` for local development. NEVER commit `.env`.
# - Keep all secrets, API tokens, and encryption keys strictly on the backend.
# - NEVER expose secrets via NEXT_PUBLIC_* variables or browser JavaScript.
# - Variables are grouped into:
#     1. MANDATORY (Local Startup) — required to boot core services.
#     2. OPTIONAL INTEGRATIONS — disabled by default (`*_ENABLED=false`);
#        developers do NOT need to populate credentials while disabled.
#     3. DEPLOYMENT-SPECIFIC & TUNING — safe defaults; override per environment.
# ==============================================================================

# ==============================================================================
# 1. MANDATORY VARIABLES (Core Local Development Startup)
# ==============================================================================

# --- Backend Runtime ---
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend Public Configuration (PUBLIC ONLY — NO SECRETS) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- PostgreSQL (Canonical Store via SQLAlchemy 2.x + Psycopg 3) ---
# Local Docker fallback parameters (required by infrastructure/docker/docker-compose.yml):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_handover
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-postgres-password
# Active SQLAlchemy + Psycopg 3 + Alembic connection URL:
# - Local Docker PostgreSQL fallback (use with POSTGRES_SSL_MODE=prefer below):
DATABASE_URL=postgresql+psycopg://postgres:change-me-local-postgres-password@localhost:5432/knowledge_handover
# - Managed Supabase PostgreSQL (Session Pooler on port 5432 — required for Alembic & Psycopg 3):
#   Replace placeholders with your Supabase session pooler details, percent-encode any
#   special characters in the password (e.g. @ -> %40, # -> %23, : -> %3A, / -> %2F),
#   and set POSTGRES_SSL_MODE=require below:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:5432/postgres

# --- ChromaDB (Dedicated HTTP Server Mode via Docker Compose) ---
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_PREFIX=ipkrh

# --- Local Ollama (LLM, Embeddings & Initial GLM OCR Runtime) ---
OLLAMA_BASE_URL=http://localhost:11434
# Initial model to benchmark
OLLAMA_LLM_MODEL=qwen3:8b
# Must remain identical between ingestion indexing and RAG query retrieval
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Initial OCR model hosted in local Ollama behind backend OCR abstraction
OLLAMA_OCR_MODEL=glm-ocr:latest

# --- FastAPI-Managed Platform Authentication & Encryption Keys ---
JWT_SECRET_KEY=change-me-generate-minimum-32-byte-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Backend symmetric key for encrypting stored external source OAuth tokens in PostgreSQL
TOKEN_ENCRYPTION_KEY=change-me-generate-32-byte-fernet-or-aes-key
# Backend symmetric key for encrypting uploaded files at rest in local private storage
FILE_ENCRYPTION_KEY=change-me-generate-32-byte-file-encryption-key

# --- Private Document Upload Storage (Outside Frontend Public Directories) ---
# Supported values: `local_encrypted` (default local encrypted filesystem) or `supabase_storage`
STORAGE_PROVIDER=local_encrypted
UPLOAD_STORAGE_PATH=./data/uploads
# Optional Supabase Storage parameters (required ONLY when STORAGE_PROVIDER=supabase_storage; keep secrets server-only):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=project-evidence
SUPABASE_STORAGE_TIMEOUT_SECONDS=30.0
SUPABASE_STORAGE_MAX_RETRIES=2
SUPABASE_STORAGE_RETRY_BACKOFF_SECONDS=0.5
SUPABASE_STORAGE_VERIFY_CIPHERTEXT_SIZE=true

# ==============================================================================
# 2. OPTIONAL SOURCE INTEGRATIONS (Disabled by Default)
# Developers do NOT need to populate credentials for disabled integrations.
# ==============================================================================

# --- GitHub API Connector (Initial Priority When Connecting External Sources) ---
GITHUB_ENABLED=false
GITHUB_AUTH_BASE_URL=https://github.com
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback
GITHUB_OAUTH_MODE=github_app
GITHUB_OAUTH_SCOPES=read:user user:email
GITHUB_ALLOW_CLASSIC_PRIVATE_REPO_SCOPE=false

# --- Jira API Connector (Initial Priority When Connecting External Sources) ---
JIRA_ENABLED=false
JIRA_AUTH_BASE_URL=https://auth.atlassian.com
JIRA_API_BASE_URL=https://api.atlassian.com
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:8000/api/v1/integrations/jira/callback
JIRA_OAUTH_SCOPES=read:jira-work read:jira-user offline_access

# --- Slack API Connector (Optional MVP — Gated by Workspace Auth, Scopes & Retention) ---
SLACK_ENABLED=false
SLACK_API_BASE_URL=https://slack.com/api
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/api/v1/integrations/slack/callback

# ==============================================================================
# 3. DEPLOYMENT-SPECIFIC & TUNING VARIABLES (Safe Defaults Provided)
# ==============================================================================

APP_NAME="Intelligent Project Knowledge Reconstruction & Handover Platform"

# JWT Issuer / Audience Validation (Optional; leave empty to omit iss/aud claims)
JWT_ISSUER=ipkrh-platform
JWT_AUDIENCE=ipkrh-api

# Authentication Rate Limiting (In-process default; replace at gateway/shared store in prod)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Cookie Security (MUST set COOKIE_SECURE=true in HTTPS staging/production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Upload Constraints & Document Extraction / OCR Tuning
MAX_UPLOAD_SIZE_MB=50
MAX_DOCUMENT_PAGES=200
OLLAMA_OCR_NUM_CTX=8192
OLLAMA_OCR_NUM_PREDICT=4096
OLLAMA_OCR_TIMEOUT_SECONDS=120
OCR_RENDER_DPI=150
OCR_MAX_IMAGE_DIMENSION=2048
OCR_MIN_TEXT_CHARS_PER_PAGE=40
OCR_MAX_PAGES_PER_DOCUMENT=40

# Lightweight Python Background Worker Tuning (PostgreSQL-Backed Job Queue)
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=15
WORKER_LEASE_SECONDS=300

# External Source OAuth & Sync Bounds
OAUTH_STATE_EXPIRE_MINUTES=10
INTEGRATION_HTTP_TIMEOUT_SECONDS=20
INTEGRATION_SYNC_MAX_ITEMS_PER_RUN=250
INTEGRATION_ALLOWED_POST_AUTH_REDIRECTS=
GITHUB_DEFAULT_COMMITS_LIMIT=50
GITHUB_DEFAULT_DOCS_LIMIT=20

# Environment-Specific Persistence Hardening (Production / Staging Overrides)
# Use `prefer` for local Docker PostgreSQL; set `require` (or `verify-full` with CA cert) for Supabase / managed PostgreSQL.
POSTGRES_SSL_MODE=prefer
CHROMA_AUTH_TOKEN=

# Phase 2.5 Chunking, Embedding, Vector Indexing & Hybrid Retrieval Tuning
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_INDEX_VERSION=v1
CHROMA_REQUEST_TIMEOUT_SECONDS=15.0
CHUNK_TARGET_CHARS=1100
CHUNK_MAX_CHARS=1400
CHUNK_OVERLAP_CHARS=150
CHUNK_MIN_CHARS=120
EMBEDDING_BATCH_SIZE=8
EMBEDDING_EXPECTED_DIMENSIONS=768
EMBEDDING_TIMEOUT_SECONDS=60.0
RETRIEVAL_DEFAULT_TOP_K=10
RETRIEVAL_MAX_TOP_K=50
RETRIEVAL_CANDIDATE_MULTIPLIER=4
RETRIEVAL_MIN_CANDIDATE_LIMIT=40
RETRIEVAL_RRF_K=60
RETRIEVAL_SEMANTIC_WEIGHT=1.0
RETRIEVAL_KEYWORD_WEIGHT=1.0
RETRIEVAL_MIN_SEMANTIC_SIMILARITY=0.15
RETRIEVAL_MIN_KEYWORD_SCORE=0.0
RETRIEVAL_MIN_HYBRID_SCORE=0.0

# Phase 2.6 AI Knowledge Reconstruction & LLM Tuning (`qwen3:8b` via local Ollama)
OLLAMA_LLM_NUM_CTX=8192
OLLAMA_LLM_NUM_PREDICT=2048
OLLAMA_LLM_TEMPERATURE=0.1
OLLAMA_LLM_TIMEOUT_SECONDS=120.0
OLLAMA_LLM_THINK=false
EXTRACTION_PROMPT_VERSION=p2.6-v1
EXTRACTION_MAX_RETRIES=2
EXTRACTION_MAX_CHUNKS_PER_BATCH=6
EXTRACTION_MAX_CHARS_PER_BATCH=5500
EXTRACTION_AUTO_REEXTRACT_ON_UPDATE=false
